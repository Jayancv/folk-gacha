# Copy to .env (git-ignored). Read by docker compose, the Go server and cmd/migrate;
# real environment variables win over values in .env.
POSTGRES_USER=cardgame
POSTGRES_PASSWORD=cardgame
POSTGRES_DB=cardgame
POSTGRES_PORT=55432

# Connection string for the Go server (pgx / goose)
DATABASE_URL=postgres://cardgame:cardgame@localhost:55432/cardgame?sslmode=disable

# Sign-in (server). APP_ENV=prod turns on Secure cookies; the Docker image sets it.
APP_ENV=dev
# OAuth client ID from Google Cloud Console (APIs & Services > Credentials). Empty = Google sign-in off.
GOOGLE_CLIENT_ID=
# 1 = enable POST /auth/dev (sign in by name, local testing only; refused with APP_ENV=prod)
DEV_LOGIN=1

# Integration tests (a separate database; the tests wipe users/sessions).
# `go test` doesn't read this file: set it in your shell to run the Postgres tests.
TEST_DATABASE_URL=postgres://cardgame:cardgame@localhost:55432/cardgame_test?sslmode=disable
