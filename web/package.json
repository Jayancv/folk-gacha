{
  "name": "folk-gacha",
  "description": "Folk Gacha: daily card packs, merging and trading. Built from the Phaser React TypeScript template.",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-react-ts.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/phaserjs/template-react-ts/issues"
  },
  "homepage": "https://github.com/phaserjs/template-react-ts#readme",
  "keywords": [
    "phaser",
    "phaser3",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.104.3",
    "openapi-fetch": "^0.17.0",
    "phaser": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^3.2.7"
  }
}
